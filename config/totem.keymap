#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        alpha_ss {
            bindings = <&tog 4>;
            key-positions = <20 37>;
        };

        symbol_ss {
            bindings = <&tog 5>;
            key-positions = <31 32>;
        };
    };

    macros {
        alpha_ss_layer_check: alpha_ss_layer_check {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RSHIFT>,
                <&macro_tap>,
                <&kp LS(LA(LC(LG(N4))))>,
                <&macro_release>,
                <&kp RSHIFT>,
                <&macro_tap>,
                <&kp LS(A) &kp L &kp P &kp H &kp A &kp SPACE &kp LS(S) &kp LS(C) &kp SPACE &kp LS(L) &kp A &kp Y &kp E &kp R>;

            label = "ALPHA_SS_LAYER_CHECK";
        };

        symbol_ss_layer_check: symbol_ss_layer_check {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp LS(LA(LC(LG(N5))))>,
                <&macro_release>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp LS(S) &kp Y &kp M &kp B &kp O &kp L &kp SPACE &kp LS(S) &kp LS(C) &kp SPACE &kp LS(L) &kp A &kp Y &kp E &kp R>;

            label = "SYMBOL_SS_LAYER_CHECK";
        };

        admin_layer_check: admin_layer_check {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp LS(LA(LC(LG(N6))))>,
                <&macro_release>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp LS(A) &kp D &kp M &kp I &kp N &kp SPACE &kp LS(L) &kp A &kp Y &kp E &kp R &sl 6>;

            label = "ADMIN_LAYER_CHECK";
        };
    };

    behaviors {
        holdtap_esc_delete: holdtap_esc_delete {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP_ESC_DELETE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        BASE {
            bindings = <
           &kp Q  &kp W  &kp E           &kp R  &kp T        &kp Y     &kp U  &kp I            &kp O    &kp P
           &kp A  &kp S  &kp D           &kp F  &kp G        &kp H     &kp J  &kp K            &kp L    &kp SEMI
&kp LCTRL  &kp Z  &kp X  &kp C           &kp V  &kp B        &kp N     &kp M  &kp COMMA        &kp DOT  &kp FSLH  &kp RCTRL
                         &kp LEFT_SHIFT  &mo 1  &kp SPACE    &kp BSPC  &mo 2  &kp RIGHT_SHIFT
            >;
        };

        NAV {
            bindings = <
        &kp ESC    &kp HOME   &kp UP_ARROW    &kp END    &kp RC(F)    &kp NUMBER_3           &kp KP_N7        &kp KP_N8        &kp KP_N9  &kp RGUI
        &kp TAB    &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &kp RC(S)    &kp NUMBER_2           &kp KP_N4        &kp KP_N5        &kp KP_N6  &kp RCTRL
&tog 6  &kp RC(Z)  &kp RC(X)  &kp RC(C)       &kp RC(V)  &kp RC(A)    &kp NUMBER_1           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3  &kp RALT   &kp KP_NUMLOCK
                              &trans          &trans     &trans       &mt RIGHT_SHIFT ENTER  &mt RCTRL KP_N0  &kp DEL
            >;
        };

        CODE {
            bindings = <
              &kp ESC    &kp AT     &kp HASH            &kp PERCENT  &none          &kp BACKSLASH  &kp PIPE   &kp AMPS           &kp LPAR        &kp RPAR
              &kp PLUS   &kp UNDER  &kp EQUAL           &kp MINUS    &none          &kp F2         &kp APOS   &kp DOUBLE_QUOTES  &kp LEFT_BRACE  &kp RBRC
&kp CAPSLOCK  &kp RC(Y)  &kp CARET  &kp STAR            &kp DOLLAR   &none          &kp TILDE      &kp GRAVE  &kp LBKT           &kp RBKT        &kp EXCL  &caps_word
                                    &kp LA(LC(DELETE))  &mo 3        &kp LA(TAB)    &trans         &trans     &trans
            >;
        };

        MOUSE {
            bindings = <
       &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
       &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&none  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                       &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Alpha.SC {
            bindings = <
           &kp Q           &kp W           &kp E           &kp R   &kp T        &kp Y          &kp U                   &kp I            &kp O            &kp P
           &mt LEFT_WIN A  &mt LEFT_ALT S  &kp D           &kp F   &kp G        &kp H          &kp J                   &kp K            &mt RIGHT_ALT L  &mt LEFT_WIN SEMI
&kp LCTRL  &kp Z           &kp X           &kp C           &kp V   &kp B        &kp N          &kp M                   &kp COMMA        &kp DOT          &kp FSLH           &kp RIGHT_CONTROL
                                           &kp LEFT_SHIFT  &tog 4  &kp SPACE    &kp BACKSPACE  &kp LS(LA(LC(LG(N4))))  &kp RIGHT_SHIFT
            >;
        };

        Symbol.SC {
            bindings = <
           &kp ESC       &kp HOME       &kp UP          &kp END                 &kp PG_UP    &kp SCROLLLOCK  &kp GRAVE  &kp INS          &kp PAUSE_BREAK  &kp PRINTSCREEN
           &mt LWIN TAB  &mt LALT LEFT  &kp DOWN        &kp RIGHT               &kp PG_DN    &kp KP_NUMLOCK  &kp MINUS  &kp EQUAL        &mt RALT LBKT    &mt RWIN RBKT
&kp LCTRL  &kp N1        &kp N2         &kp N3          &kp N4                  &kp N5       &kp N6          &kp N7     &kp N8           &kp N9           &kp N0           &kp RCTRL
                                        &kp LEFT_SHIFT  &kp LS(LA(LC(LG(N5))))  &kp DEL      &kp ENTER       &tog 5     &kp RIGHT_SHIFT
            >;
        };

        ADMIN {
            bindings = <
        &bt BT_CLR_ALL  &studio_unlock  &none         &sys_reset    &bootloader     &none  &none  &none  &none  &none
        &none           &none           &none         &none         &none           &none  &kp T  &kp S  &kp E  &kp T
&tog 6  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none  &none  &none  &none  &none
                                        &kp LSHIFT    &tog 0        &tog 6          &none  &none  &none
            >;
        };
    };
};
