#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

/* Timeless homerow mods */
// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // right hand
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // thumbs

ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)

ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        base_hrm_combo {
            bindings = <&tog 1>;
            key-positions = <10 33 19 36>;
        };

        bt_0_combo {
            bindings = <&bt BT_SEL 0>;
            key-positions = <10 4>;
            layers = <3>;
        };

        bt_1_combo {
            bindings = <&bt BT_SEL 1>;
            key-positions = <10 13>;
            layers = <3>;
        };

        bt_2_combo {
            bindings = <&bt BT_SEL 2>;
            key-positions = <10 3>;
            layers = <3>;
        };

        bt_3_combo {
            bindings = <&bt BT_SEL 3>;
            key-positions = <10 2>;
            layers = <3>;
        };

        bt_4_combo {
            bindings = <&bt BT_SEL 4>;
            key-positions = <10 2>;
            layers = <3>;
        };

        admin_layer_combo {
            bindings = <&sl 6>;
            key-positions = <1 2 3>;
            layers = <3>;
        };
    };

    behaviors {
        holdtap_esc_delete: holdtap_esc_delete {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP_ESC_DELETE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        BASE {
            bindings = <
           &kp Q  &kp W  &kp E           &kp R  &kp T        &kp Y     &kp U  &kp I            &kp O    &kp P
           &kp A  &kp S  &kp D           &kp F  &kp G        &kp H     &kp J  &kp K            &kp L    &kp SEMI
&kp LCTRL  &kp Z  &kp X  &kp C           &kp V  &kp B        &kp N     &kp M  &kp COMMA        &kp DOT  &kp FSLH  &kp RCTRL
                         &kp LEFT_SHIFT  &mo 3  &kp SPACE    &kp BSPC  &mo 4  &kp RIGHT_SHIFT
            >;
        };

        BASE_HRM {
            bindings = <
            &kp Q        &kp W       &kp E      &kp R       &kp T        &kp Y          &kp U       &kp I      &kp O       &kp P
            &mt LCTRL A  &mt LALT S  &kp D      &mt LGUI F  &kp G        &kp H          &mt RGUI J  &kp K      &mt RALT L  &mt RCTRL SEMI
&kp DELETE  &kp Z        &kp X       &kp C      &kp V       &kp B        &kp N          &kp M       &kp COMMA  &kp DOT     &kp FSLH        &kp ENTER
                                     &kp LSHFT  &mo 3       &kp SPACE    &kp BACKSPACE  &mo 4       &kp RSHFT
            >;
        };

        SYMBOL_HRM {
            bindings = <
       &kp ESC        &kp HOME       &kp UP        &kp END         &kp PG_UP         &kp EQUAL  &kp N7             &kp N8        &kp N9             &kp RIGHT_BRACKET
       &mt LCTRL TAB  &mt LALT LEFT  &kp DOWN      &mt LGUI RIGHT  &kp PG_DN         &kp MINUS  &mt RGUI NUMBER_4  &kp N5        &mt RALT NUMBER_6  &mt RCTRL LEFT_BRACKET
&none  &kp GRAVE      &none          &kp CAPSLOCK  &none           &kp KP_NUMLOCK    &kp N0     &kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3       &kp APOSTROPHE          &none
                                     &kp LSHFT     &none           &none             &none      &none              &kp RSHFT
            >;
        };

        NAV {
            bindings = <
             &kp ESC    &kp HOME   &kp UP_ARROW    &kp END    &kp RC(F)    &kp NUMBER_3           &kp KP_N7        &kp KP_N8        &kp KP_N9  &kp RGUI
             &kp TAB    &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &kp RC(S)    &kp NUMBER_2           &kp KP_N4        &kp KP_N5        &kp KP_N6  &kp RCTRL
&kp LA(TAB)  &kp RC(Z)  &kp RC(X)  &kp RC(C)       &kp RC(V)  &kp RC(A)    &kp NUMBER_1           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3  &kp RALT   &kp KP_NUMLOCK
                                   &trans          &trans     &trans       &mt RIGHT_SHIFT ENTER  &mt RCTRL KP_N0  &mo 2
            >;
        };

        CODE {
            bindings = <
              &kp ESC    &kp AT     &kp HASH   &kp PERCENT  &none              &kp BACKSLASH  &kp PIPE   &kp AMPS           &kp LPAR        &kp RPAR
              &kp PLUS   &kp UNDER  &kp EQUAL  &kp MINUS    &none              &kp F2         &kp APOS   &kp DOUBLE_QUOTES  &kp LEFT_BRACE  &kp RBRC
&kp CAPSLOCK  &kp RC(Y)  &kp CARET  &kp STAR   &kp DOLLAR   &none              &kp TILDE      &kp GRAVE  &kp LBKT           &kp RBKT        &kp EXCL  &caps_word
                                    &mo 2      &mo 5        &kp LC(LA(DEL))    &trans         &trans     &trans
            >;
        };

        MOUSE {
            bindings = <
       &trans  &mmv MOVE_X(-600)  &mmv MOVE_UP    &mmv MOVE_X(600)  &trans    &trans  &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT  &trans
       &trans  &mmv MOVE_LEFT     &mmv MOVE_DOWN  &mmv MOVE_RIGHT   &trans    &trans  &mkp MB1        &msc SCRL_DOWN  &mkp MB3         &mkp MB2
&none  &trans  &trans             &trans          &trans            &trans    &trans  &mkp MB4        &trans          &mkp MB5         &trans    &trans
                                  &trans          &trans            &trans    &trans  &trans          &trans
            >;
        };

        ADMIN {
            bindings = <
       &studio_unlock  &none       &none       &none       &sys_reset     &none  &none  &none  &none  &none
       &none           &bt BT_PRV  &none       &bt BT_NXT  &none          &none  &kp T  &kp S  &kp E  &kp T
&none  &bt BT_CLR_ALL  &none       &bt BT_CLR  &none       &bootloader    &none  &none  &none  &none  &none  &none
                                   &none       &mo 6       &tog 6         &none  &none  &none
            >;
        };
    };
};
