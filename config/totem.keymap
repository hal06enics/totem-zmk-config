#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Adding pointing.h to be able to right and middle click
// https://zmk.dev/docs/keymaps/behaviors/mouse-emulation
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
// Used only by macOS A/Command. Position 30 is N, which must not turn an A-N roll into Command+N.
#define KEYS_R_EXCEPT_N 6 7 8 9 10 11 18 19 20 21 22 23 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41
#define HRM_PRIOR_IDLE_MS 150
#define HRM_MAC_A_TAPPING_TERM_MS 200

/ {
    behaviors {
        // Testing urob's timeless home-row mods:
        // https://github.com/urob/zmk-config#timeless-homerow-mods
        // Cross-hand shortcuts can resolve immediately; same-hand shortcuts still
        // require holding past tapping-term-ms before pressing the next key.
        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            // How long a plain hold waits before becoming the modifier.
            // Cross-hand shortcuts can still resolve sooner via balanced + hold-trigger-key-positions.
            tapping-term-ms = <300>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            // If this HRM is tapped and quickly pressed again, keep the second press as a tap.
            // Useful for repeating letters without the second press becoming the modifier.
            quick-tap-ms = <300>;
            // If pressed within this window after a normal key, force a tap so fast typing stays immediate.
            // Lower this if intended HRM shifts/mods are blocked while typing quickly;
            // raise it if fast rolls accidentally trigger modifiers.
            require-prior-idle-ms = <HRM_PRIOR_IDLE_MS>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <HRM_PRIOR_IDLE_MS>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
};

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        alpha_sc_combo {
            bindings = <&tog 5>;
            key-positions = <20 37>;
        };

        symbol_sc_combo {
            bindings = <&tog 6>;
            key-positions = <31 32>;
        };

        bt_0_combo {
            bindings = <&bt BT_SEL 0>;
            key-positions = <10 4>;
            layers = <2>;
        };

        bt_1_combo {
            bindings = <&bt BT_SEL 1>;
            key-positions = <10 13>;
            layers = <2>;
        };

        bt_2_combo {
            bindings = <&bt BT_SEL 2>;
            key-positions = <10 3>;
            layers = <2>;
        };

        bt_3_combo {
            bindings = <&bt BT_SEL 3>;
            key-positions = <10 2>;
            layers = <2>;
        };

        bt_4_combo {
            bindings = <&bt BT_SEL 4>;
            key-positions = <10 2>;
            layers = <2>;
        };

        admin_layer_combo {
            bindings = <&sl 7>;
            key-positions = <1 2 3>;
            layers = <2>;
        };

        base_combo {
            bindings = <&tog 0>;
            key-positions = <33 36 2 7>;
        };

        base_hrm_combo {
            bindings = <&tog 1>;
            key-positions = <36 33 0 9>;
        };
    };

    macros {
        Alpha_LC: alpha_ss_layer_check {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LS(A) &kp L &kp P &kp H &kp A &kp SPACE &kp LS(S) &kp LS(C) &kp SPACE &kp LS(L) &kp A &kp Y &kp E &kp R>;

            label = "ALPHA_SS_LAYER_CHECK";
        };

        Symbol_LC: symbol_ss_layer_check {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LS(S) &kp Y &kp M &kp B &kp O &kp L &kp SPACE &kp LS(S) &kp LS(C) &kp SPACE &kp LS(L) &kp A &kp Y &kp E &kp R>;

            label = "SYMBOL_SS_LAYER_CHECK";
        };

        Admin_LC: admin_layer_check {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LS(A) &kp D &kp M &kp I &kp N &kp SPACE &kp LS(L) &kp A &kp Y &kp E &kp R>;

            label = "ADMIN_LAYER_CHECK";
        };
    };

    behaviors {
        holdtap_esc_delete: holdtap_esc_delete {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP_ESC_DELETE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        BASE {
            bindings = <
           &kp Q  &kp W  &kp E           &kp R  &kp T        &kp Y     &kp U  &kp I            &kp O    &kp P
           &kp A  &kp S  &kp D           &kp F  &kp G        &kp H     &kp J  &kp K            &kp L    &kp SEMI
&kp LCTRL  &kp Z  &kp X  &kp C           &kp V  &kp B        &kp N     &kp M  &kp COMMA        &kp DOT  &kp FSLH  &kp RCTRL
                         &kp LEFT_SHIFT  &mo 2  &kp SPACE    &kp BSPC  &mo 3  &kp RIGHT_SHIFT
            >;
        };

        BASE_HRM {
            bindings = <
           &kp Q        &kp W       &kp E           &kp R  &kp T        &kp Y     &kp U  &kp I            &kp O       &kp P
           &mt LCTRL A  &mt LGUI S  &mt LALT D      &kp F  &kp G        &kp H     &kp J  &mt RALT K       &mt RGUI L  &mt RCTRL SEMI
&kp LCTRL  &kp Z        &kp X       &kp C           &kp V  &kp B        &kp N     &kp M  &kp COMMA        &kp DOT     &kp FSLH        &kp RCTRL
                                    &kp LEFT_SHIFT  &mo 2  &kp SPACE    &kp BSPC  &mo 3  &kp RIGHT_SHIFT
            >;
        };

        NAV {
            bindings = <
             &kp ESC    &kp HOME   &kp UP_ARROW    &kp END    &kp RC(F)    &kp NUMBER_3           &kp KP_N7        &kp KP_N8        &kp KP_N9  &kp RGUI
             &kp TAB    &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &kp RC(S)    &kp NUMBER_2           &kp KP_N4        &kp KP_N5        &kp KP_N6  &kp RCTRL
&kp LA(TAB)  &kp RC(Z)  &kp RC(X)  &kp RC(C)       &kp RC(V)  &kp RC(A)    &kp NUMBER_1           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3  &kp RALT   &kp KP_NUMLOCK
                                   &trans          &trans     &trans       &mt RIGHT_SHIFT ENTER  &mt RCTRL KP_N0  &kp DEL
            >;
        };

        CODE {
            bindings = <
              &kp ESC    &kp AT     &kp HASH            &kp PERCENT  &none    &kp BACKSLASH  &kp PIPE   &kp AMPS           &kp LPAR        &kp RPAR
              &kp PLUS   &kp UNDER  &kp EQUAL           &kp MINUS    &none    &kp F2         &kp APOS   &kp DOUBLE_QUOTES  &kp LEFT_BRACE  &kp RBRC
&kp CAPSLOCK  &kp RC(Y)  &kp CARET  &kp STAR            &kp DOLLAR   &none    &kp TILDE      &kp GRAVE  &kp LBKT           &kp RBKT        &kp EXCL  &caps_word
                                    &kp LA(LC(DELETE))  &mo 4        &none    &trans         &trans     &trans
            >;
        };

        MOUSE {
            bindings = <
       &trans  &mmv MOVE_X(-600)  &mmv MOVE_UP    &mmv MOVE_X(600)  &trans    &trans  &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT  &trans
       &trans  &mmv MOVE_LEFT     &mmv MOVE_DOWN  &mmv MOVE_RIGHT   &trans    &trans  &mkp MB1        &msc SCRL_DOWN  &mkp MB3         &mkp MB2
&none  &trans  &trans             &trans          &trans            &trans    &trans  &mkp MB4        &trans          &mkp MB5         &trans    &trans
                                  &trans          &trans            &trans    &trans  &trans          &trans
            >;
        };

        Alpha.SC {
            bindings = <
           &kp Q           &kp W           &kp E           &kp R   &kp T        &kp Y          &kp U      &kp I            &kp O            &kp P
           &mt LEFT_WIN A  &mt LEFT_ALT S  &kp D           &kp F   &kp G        &kp H          &kp J      &kp K            &mt RIGHT_ALT L  &mt LEFT_WIN SEMI
&kp LCTRL  &kp Z           &kp X           &kp C           &kp V   &kp B        &kp N          &kp M      &kp COMMA        &kp DOT          &kp FSLH           &kp RIGHT_CONTROL
                                           &kp LEFT_SHIFT  &tog 5  &kp SPACE    &kp BACKSPACE  &Alpha_LC  &kp RIGHT_SHIFT
            >;
        };

        Symbol.SC {
            bindings = <
           &kp ESC       &kp HOME       &kp UP          &kp END     &kp PG_UP    &kp SCROLLLOCK  &kp GRAVE  &kp INS          &kp PAUSE_BREAK  &kp PRINTSCREEN
           &mt LWIN TAB  &mt LALT LEFT  &kp DOWN        &kp RIGHT   &kp PG_DN    &kp KP_NUMLOCK  &kp MINUS  &kp EQUAL        &mt RALT LBKT    &mt RWIN RBKT
&kp LCTRL  &kp N1        &kp N2         &kp N3          &kp N4      &kp N5       &kp N6          &kp N7     &kp N8           &kp N9           &kp N0           &kp RCTRL
                                        &kp LEFT_SHIFT  &Symbol_LC  &kp DEL      &kp ENTER       &tog 6     &kp RIGHT_SHIFT
            >;
        };

        ADMIN {
            bindings = <
       &studio_unlock  &none       &none       &none       &sys_reset     &none  &none  &none  &none  &none
       &none           &bt BT_PRV  &Admin_LC   &bt BT_NXT  &none          &none  &kp T  &kp S  &kp E  &kp T
&none  &bt BT_CLR_ALL  &none       &bt BT_CLR  &none       &bootloader    &none  &none  &none  &none  &none  &none
                                   &none       &mo 7       &tog 7         &none  &none  &none
            >;
        };
    };
};
